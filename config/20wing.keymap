#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1650  // default is 600

/ {
    combos {
        compatible = "zmk,combos";

        bootloader {
            bindings = <&bootloader>;
            key-positions = <0 1 17 6 7 18 16 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp Q  &kp W  &kp E      &kp R      &kp T      &kp Y     &kp U  &kp I
&kp A  &kp S  &kp D      &kp F      &kp G      &kp H     &kp J  &kp K
              &kp LCTRL  &kp LSHFT  &kp SPACE  &kp BSPC
            >;
        };
    };
};
